{
  "apps": [
    {
      "name": "7zip",
      "source": "github:ip7z/7zip",
      "file": "^7z\\d+-x64\\.exe$",
      "args": "/S",
      "detect": "^7-Zip"
    },
    {
      "name": "Helium",
      "source": "github:imputnet/helium-windows",
      "file": "^helium_[\\d.]+_x64-installer\\.exe$",
      "args": "/S /SYSTEM",
      "exe": "%ProgramFiles%\\imput\\Helium\\Application\\chrome.exe"
    },
    {
      "name": "OBS",
      "source": "github:obsproject/obs-studio",
      "file": "Windows-x64-Installer\\.exe$",
      "args": "/S",
      "detect": "^OBS Studio",
      "exe": "%ProgramFiles%\\obs-studio\\bin\\64bit\\obs64.exe",
      "startAtLogon": true,
      "startArgs": "--startreplaybuffer --minimize-to-tray",
      "startAsAdmin": true,
      "close": ["obs64"],
      "configs": {
        "obs-studio/basic": "%APPDATA%\\obs-studio\\basic",
        "obs-studio/global.ini": "%APPDATA%\\obs-studio\\global.ini",
        "obs-studio/user.ini": "%APPDATA%\\obs-studio\\user.ini"
      }
    },
    {
      "name": "Discord",
      "source": "https://discord.com/api/downloads/distributions/app/installers/latest?channel=stable&platform=win&arch=x64",
      "file": "DiscordSetup.exe",
      "args": "-s",
      "detect": "^Discord$"
    },
    {
      "name": "SpotX",
      "command": "iex \"& { $(iwr -useb 'https://raw.githubusercontent.com/SpotX-Official/SpotX/refs/heads/main/run.ps1') } -confirm_uninstall_ms_spoti -confirm_spoti_recomended_over -podcasts_off -block_update_on -start_spoti -new_theme -adsections_off -lyrics_stat spotify\"",
      "runAsUser": true,
      "detect": "^Spotify"
    },
    {
      "name": "NotepadPP",
      "source": "github:notepad-plus-plus/notepad-plus-plus",
      "file": "\\.Installer\\.x64\\.exe$",
      "args": "/S",
      "detect": "^Notepad\\+\\+"
    },
    {
      "name": "Lightshot",
      "source": "https://app.prntscr.com/build/setup-lightshot.exe",
      "file": "setup-lightshot.exe",
      "args": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
      "detect": "^Lightshot"
    },
    {
      "name": "LosslessCut",
      "source": "github:mifi/lossless-cut",
      "file": "^LosslessCut-win-x64\\.7z$",
      "portable": true,
      "exe": "%ProgramFiles%\\LosslessCut\\LosslessCut.exe",
      "shortcut": true,
      "close": ["LosslessCut"],
      "configs": {
        "LosslessCut/config.json": "%APPDATA%\\LosslessCut\\config.json"
      }
    },
    {
      "name": "mpv",
      "source": "github:shinchiro/mpv-winbuild-cmake",
      "file": "^mpv-x86_64-v3-\\d+-git-.*\\.7z$",
      "portable": true,
      "exe": "%ProgramFiles%\\mpv\\mpv.exe",
      "shortcut": true,
      "afterInstall": ["installer\\mpv-install.bat /u"]
    },
    {
      "name": "PaintNET",
      "source": "github:paintdotnet/release",
      "file": "\\.winmsi\\.x64\\.zip$",
      "detect": "^paint\\.net"
    },
    {
      "name": "Revo",
      "source": "https://download.revouninstaller.com/download/revosetup.exe",
      "file": "revosetup.exe",
      "args": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
      "detect": "^Revo Uninstaller"
    },
    {
      "name": "HWiNFO",
      "source": "sourceforge:hwinfo/Windows_Installer",
      "file": "^hwi64_\\d+\\.exe$",
      "args": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
      "signer": "REALiX",
      "detect": "^HWiNFO"
    },
    {
      "name": "ZenTimings",
      "source": "github:irusanov/ZenTimings",
      "file": "^ZenTimings_.*\\.zip$",
      "portable": true,
      "exe": "%ProgramFiles%\\ZenTimings\\ZenTimings.exe",
      "shortcut": true
    },
    {
      "name": "Office",
      "source": "https://officecdn.microsoft.com/pr/wsus/setup.exe",
      "file": "odt-setup.exe",
      "args": "/configure \"{configs}\\Office\\Configuration.xml\"",
      "hidden": true,
      "signer": "O=Microsoft Corporation",
      "detect": "^Microsoft (365|Office)"
    }
  ]
}
