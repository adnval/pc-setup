{
  "apps": [
    {
      "name": "7zip",
      "type": "installer",
      "source": { "from": "github", "location": "ip7z/7zip", "file": "^7z\\d+-x64\\.exe$" },
      "install": { "args": "/S", "hidden": false, "signer": "", "command": "", "runAsUser": false },
      "exe": "%ProgramFiles%\\7-Zip\\7zFM.exe",
      "detect": "^7-Zip",
      "startMenuShortcut": false,
      "startAtLogon": { "enabled": false, "args": "", "admin": false },
      "afterInstall": [],
      "configs": []
    },
    {
      "name": "OBS",
      "type": "installer",
      "source": { "from": "github", "location": "obsproject/obs-studio", "file": "Windows-x64-Installer\\.exe$" },
      "install": { "args": "/S", "hidden": false, "signer": "", "command": "", "runAsUser": false },
      "exe": "%ProgramFiles%\\obs-studio\\bin\\64bit\\obs64.exe",
      "detect": "^OBS Studio",
      "startMenuShortcut": false,
      "startAtLogon": { "enabled": true, "args": "--startreplaybuffer --minimize-to-tray", "admin": true },
      "afterInstall": [],
      "configs": [
        { "repo": "obs-studio/basic",      "target": "%APPDATA%\\obs-studio\\basic",      "closeFirst": ["obs64"] },
        { "repo": "obs-studio/global.ini", "target": "%APPDATA%\\obs-studio\\global.ini", "closeFirst": ["obs64"] },
        { "repo": "obs-studio/user.ini",   "target": "%APPDATA%\\obs-studio\\user.ini",   "closeFirst": ["obs64"] }
      ]
    },
    {
      "name": "Discord",
      "type": "installer",
      "source": { "from": "url", "location": "https://discord.com/api/downloads/distributions/app/installers/latest?channel=stable&platform=win&arch=x64", "file": "DiscordSetup.exe" },
      "install": { "args": "-s", "hidden": false, "signer": "", "command": "", "runAsUser": false },
      "exe": "",
      "detect": "^Discord$",
      "startMenuShortcut": false,
      "startAtLogon": { "enabled": false, "args": "", "admin": false },
      "afterInstall": [],
      "configs": []
    },
    {
      "name": "SpotX",
      "type": "command",
      "source": { "from": "", "location": "", "file": "" },
      "install": { "args": "", "hidden": false, "signer": "", "runAsUser": true,
                   "command": "iex \"& { $(iwr -useb 'https://raw.githubusercontent.com/SpotX-Official/SpotX/refs/heads/main/run.ps1') } -confirm_uninstall_ms_spoti -confirm_spoti_recomended_over -podcasts_off -block_update_on -start_spoti -new_theme -adsections_off -lyrics_stat spotify\"" },
      "exe": "",
      "detect": "^Spotify",
      "startMenuShortcut": false,
      "startAtLogon": { "enabled": false, "args": "", "admin": false },
      "afterInstall": [],
      "configs": []
    },
    {
